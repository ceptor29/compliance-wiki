# Database (Turso/libsql free tier, or local file for development)
DATABASE_URL=libsql://your-db-org.turso.io
# Required for Turso (from: turso db tokens create)
TURSO_AUTH_TOKEN=

# AI provider for the collection job.
#   Groq (free): AI_PROVIDER=openai-compatible, AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=llama-3.3-70b-versatile
#   Also supported: openai | gemini | ollama
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# Only needed for openai-compatible / ollama
AI_BASE_URL=https://api.groq.com/openai/v1

# Web search for discovery mode (npm run discover). Free tiers:
#   serper (2500/mo), tavily (1000/mo), brave (2000/mo). Set SEARCH_PROVIDER to
#   "serper" | "tavily" | "brave" | "auto"; "auto" tries each with the key.
#   Optional: SEARXNG_URL=https://your-searxng-instance for a no-key fallback.
SEARCH_PROVIDER=serper
SEARCH_API_KEY=
SEARXNG_URL=

# Email provider (Resend or Buttondown) — used by the newsletter digest
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=digest@yourdomain.com
